  "space": [4, 8, 12, 16, 20, 24, 32],
  "motion": {
    "$comment": "Fluid motion, chosen by Matteo on 2026-10-21 (MotionToApprove, style 8): things that move ride springs (spatial, which may overshoot a touch); fades and colors use `curve` and never overshoot. Screens grow out of what was touched. With reduce motion everything is instant. Swipes are sticky (M3 Expressive, Matteo 2026-10-22): before the point where letting go acts (`swipeAt` of the width) the row follows the finger at `swipeResist`, there it snaps to the finger on the fast spring, and below `swipeRelease` of that point it lets go again. Progress lines are wavy while they run: the wave travels one `waveLengthPx` every `waveMs`, flattens when done, and an unknown progress sweeps every `waveSweepMs`.",
    "curve": [0.22, 1, 0.36, 1],
    "spatialDamping": 0.8,
    "spatialStiffness": 380,
    "spatialMs": 500,
    "fastDamping": 0.6,
    "fastStiffness": 800,
    "fastMs": 350,
    "pressMs": 160,
    "pressScale": 0.96,
    "enterMs": 260,
    "enterRisePx": 4,
    "staggerMs": 40,
    "moveMs": 400,
    "collapseMs": 460,
    "revealMs": 700,
    "noteMs": 2000,
    "themeMs": 200,
    "pulseMs": 1600,
    "pulseStaggerMs": 180,
    "pulseLow": 0.45,
    "backScale": 0.92,
    "sinkScale": 0.94,
    "sinkOpacity": 0.6,
    "backShiftPx": 8,
    "toastMs": 4000,
    "toastActionMs": 6000,
    "swipeAt": 0.25,
    "swipeResist": 0.55,
    "swipeRelease": 0.85,
    "waveMs": 1100,
    "waveSweepMs": 1800,
    "waveLengthPx": 22,
    "waveAmplitudePx": 1.6
  }
