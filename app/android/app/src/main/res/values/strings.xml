<?xml version="1.0" encoding="utf-8"?>
<!-- What the background service writes itself; the app's own words are in
     lib/l10n. Keep notice_channel and notice_title_many in step with
     noticeChannel and noticeTitleMany there, notice_sign_in_title and
     notice_sign_in_body with noticeSignInTitle and accountPasswordRefused. -->
<resources>
    <string name="notice_channel">New mail</string>
    <string name="notice_quiet_channel">New mail, quiet hours</string>
    <plurals name="notice_title_many">
        <item quantity="one">%1$s · %2$d email</item>
        <item quantity="other">%1$s · %2$d emails</item>
    </plurals>
    <string name="notice_reply">Reply</string>
    <string name="notice_reply_hint">Reply to %s</string>
    <string name="notice_archive">Archive</string>
    <string name="notice_snooze">Snooze</string>
    <string name="notice_failed">Couldn’t do that from the notification. Open Piuma Mail to try again.</string>
    <string name="notice_sign_in_title">%1$s can\'t sign in</string>
    <string name="notice_sign_in_body">The server refused the password. Did it change?</string>
    <string name="vault_notice_label">Vault</string>
    <string name="vault_notice_parcel">Your package arrives today</string>
    <string name="vault_notice_due_today">Due today</string>
    <string name="vault_notice_due_tomorrow">Due tomorrow</string>
    <plurals name="vault_notice_due_in">
        <item quantity="one">Due in %d day</item>
        <item quantity="other">Due in %d days</item>
    </plurals>
    <string name="vault_notice_around">around %s</string>
    <string name="background_channel">Keeping mail up to date</string>
    <plurals name="background_title">
        <item quantity="one">Keeping %d account up to date</item>
        <item quantity="other">Keeping %d accounts up to date</item>
    </plurals>
    <string name="background_detail">New mail shows up here as it arrives</string>
    <!-- Keep in step with noticeAwayTitle, noticeAwayEmails and noticeAwayPeople. -->
    <string name="notice_away_title">While you were away</string>
    <plurals name="notice_away_emails">
        <item quantity="one">%d email</item>
        <item quantity="other">%d emails</item>
    </plurals>
    <plurals name="notice_away_people">
        <item quantity="one">%d from a person</item>
        <item quantity="other">%d from people</item>
    </plurals>
    <!-- Keep in step with remindNoReply, remindSentToday, remindSentYesterday
         and remindSentDaysAgo. -->
    <string name="remind_no_reply">No reply from %s</string>
    <string name="remind_sent_today">sent today</string>
    <string name="remind_sent_yesterday">sent yesterday</string>
    <plurals name="remind_sent_days_ago">
        <item quantity="one">sent %d day ago</item>
        <item quantity="other">sent %d days ago</item>
    </plurals>
</resources>
